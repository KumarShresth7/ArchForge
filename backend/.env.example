# Shared secret for JWT tokens (must match frontend AUTH_SECRET)
AUTH_SECRET=dev-secret-change-in-production

# Groq API key for AI evaluation (optional - deterministic fallback provided when unset)
GROQ_API_KEY=your_groq_api_key

# Groq Model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Database (defaults to SQLite: jdbc:sqlite:./archforge.db)
SPRING_DATASOURCE_URL=jdbc:sqlite:./archforge.db

# CORS Allowed Origins (default: http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server port (default: 8000)
SERVER_PORT=8000
